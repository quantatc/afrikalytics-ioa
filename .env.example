# Copy this file to .env and fill with real values.
# .env is git-ignored in this repository.

# Local dev uses layer1/ioa_dev.db automatically.
# Production uses Postgres. Example:
# DATABASE_URL=postgresql://insights_tracker:strong_password@127.0.0.1:5432/insights_tracker
DATABASE_URL=
POSTGRES_PASSWORD=replace_with_a_strong_password
OPENAI_API_KEY=your_openai_api_key

# Optional Layer 2 tuning
LAYER2_MODEL=gpt-4o-mini
LAYER2_EMBEDDING_MODEL=text-embedding-3-small
LAYER2_EMBEDDING_DIMS=384
LAYER2_BATCH_SIZE=50

# Layer 3
LAYER3_MODEL=gpt-4o-mini
LAYER3_PERIOD_DAYS=7
LAYER3_MAX_ARTICLES=120
LAYER3_MIN_RELEVANCE=3
